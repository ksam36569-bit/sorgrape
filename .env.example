# Local development: copy to frontend/.env and fill in.
# Vercel: set these under Project Settings -> Environment Variables.
#
# Create React App inlines REACT_APP_* at BUILD time, so changing them
# requires a restart locally and a redeploy on Vercel.

# --- Supabase (required) ---
# Dashboard -> Project Settings -> API
# The anon key is a publishable key and is meant to ship in the browser bundle.
# What protects your data is Row Level Security — see the warning in
# supabase/migrations/0001_init.sql. Never put the service_role key here.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# --- Server-side only (Vercel env vars, never REACT_APP_ prefixed) ---
# Used by api/ai-summary.js. Prefixing any of these with REACT_APP_ would
# publish them in the JavaScript bundle.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# At least one provider is required for the Analyze & Summarize feature.
# OpenAI is tried first; Anthropic is the fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides, in case a provider renames a model.
# OPENAI_MODEL=gpt-5
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
