# Local development: copy to frontend/.env
# Vercel: Project Settings -> Environment Variables
#
# Create React App inlines REACT_APP_* at BUILD time, so changes need a restart
# locally and a redeploy on Vercel.

# --- Supabase (required) ---
# Dashboard -> Project Settings -> API
#
# The anon key is a publishable key and is meant to ship in the browser bundle.
# What protects the data is Row Level Security -- see the warning at the bottom
# of supabase/migrations/0001_init.sql. Never put the service_role key here.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# --- Server-side only, for api/ai-summary.js ---
# Never prefix these with REACT_APP_ -- that would publish them in the bundle.
# At least one is required for "Analyze & Summarize". OpenAI is tried first,
# Anthropic is the fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional, if a provider renames a model.
# OPENAI_MODEL=gpt-5
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
