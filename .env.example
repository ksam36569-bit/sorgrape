# Scorecards are stored in the browser (IndexedDB), so there is no database to
# configure and nothing to set for local development — `npm start` just works.
#
# These are only needed for the "Analyze & Summarize" briefing, and only on the
# server. Set them in Vercel under Project Settings -> Environment Variables.
#
# Never prefix these with REACT_APP_. Create React App inlines REACT_APP_*
# variables into the JavaScript bundle, which would publish your key.

# At least one is required. OpenAI is tried first; Anthropic is the fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides, in case a provider renames a model.
# OPENAI_MODEL=gpt-5
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
