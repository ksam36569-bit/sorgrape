{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --no-audit --no-fund && cd frontend && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/ai-summary.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}